{
	"name": "keeper-security",
	"commands": [
		"std:account:list",
		"std:account:read",
		"std:account:create",
		"std:account:update",
		"std:account:disable",
		"std:account:enable",
		"std:entitlement:list",
		"std:entitlement:read",
		"std:test-connection"
	],
	"sourceConfig": [
		{
			"type": "menu",
			"label": "Configuration",
			"items": [
				{
					"type": "section",
					"sectionTitle": "Authentication",
					"sectionHelpMessage": "Provide connection parameters to interact securely with the target application.",
					"items": [
						{
							"key": "serviceModeApiUrl",
							"label": "Keeper Commander Service Mode API URL",
							"type": "text",
							"required": true,
							"placeholder": "Your Base API URL Here ( without /api/v2/)"
						},
						{
							"key": "serviceModeApiKey",
							"label": "Keeper Commander Service Mode API Key",
							"type": "secret",
							"required": true,
							"placeholder": "Your API Key Here"
						},
						{
							"key": "pollTimeoutSeconds",
							"label": "Keeper Service Mode Poll Timeout (seconds)",
							"type": "text",
							"required": false,
							"placeholder": "Default is 60 seconds"
						}
					]
				}
			]
		}
	],
	"accountSchema": {
		"displayAttribute": "email",
		"identityAttribute": "email",
		"attributes": [
			{
				"name": "userId",
				"type": "string",
				"description": "Keeper enterprise user_id (stable numeric ID as string)"
			},
			{
				"name": "email",
				"type": "string",
				"description": "Primary email address; used as the account identifier",
				"required": true
			},
			{
				"name": "name",
				"type": "string",
				"description": "Full name as stored in Keeper",
				"required": true
			},
			{
				"name": "status",
				"type": "string",
				"description": "Keeper enterprise user status (Invited, Active, Locked, etc.)"
			},
			{
				"name": "jobTitle",
				"type": "string",
				"description": "Job title"
			},
			{
				"name": "twoFactorEnabled",
				"type": "boolean",
				"description": "Whether 2FA is enabled on the vault"
			},
			{
				"name": "aliases",
				"type": "string",
				"description": "Alternate email aliases",
				"multi": true
			},
			{
				"name": "nodePath",
				"type": "string",
				"description": "Full node path (display only). Node identity lives in the node entitlement."
			},
			{
				"name": "node",
				"type": "string",
				"description": "Enterprise node the user belongs to (single-valued entitlement). Required on create because Keeper enterprise users must be placed in a node.",
				"entitlement": true,
				"managed": true,
				"multi": false,
				"required": true,
				"schemaObjectType": "node"
			},
			{
				"name": "teams",
				"type": "string",
				"description": "Team memberships (team_uid values)",
				"entitlement": true,
				"managed": true,
				"multi": true,
				"schemaObjectType": "team"
			},
			{
				"name": "roles",
				"type": "string",
				"description": "Direct role memberships (role_id values)",
				"entitlement": true,
				"managed": true,
				"multi": true,
				"schemaObjectType": "role"
			}
		]
	},
	"entitlementSchemas": [
		{
			"type": "node",
			"displayAttribute": "path",
			"identityAttribute": "id",
			"attributes": [
				{
					"name": "id",
					"type": "string",
					"description": "node_id (stable numeric ID as string)"
				},
				{
					"name": "name",
					"type": "string",
					"description": "Node display name"
				},
				{
					"name": "path",
					"type": "string",
					"description": "Full node path (e.g. Metron Security\\Dev Node2)"
				},
				{
					"name": "parentId",
					"type": "string",
					"description": "Parent node_id"
				},
				{
					"name": "parentPath",
					"type": "string",
					"description": "Parent node path"
				},
				{
					"name": "isolated",
					"type": "boolean",
					"description": "Whether the node is isolated"
				}
			]
		},
		{
			"type": "team",
			"displayAttribute": "name",
			"identityAttribute": "id",
			"attributes": [
				{
					"name": "id",
					"type": "string",
					"description": "team_uid"
				},
				{
					"name": "name",
					"type": "string",
					"description": "Team display name"
				},
				{
					"name": "nodeId",
					"type": "string",
					"description": "Owning node_id"
				},
				{
					"name": "nodePath",
					"type": "string",
					"description": "Owning node path"
				},
				{
					"name": "restricts",
					"type": "string",
					"description": "Raw Keeper restrict flags (e.g. '  W S'); decoded attributes may be added later"
				}
			]
		},
		{
			"type": "role",
			"displayAttribute": "name",
			"identityAttribute": "id",
			"attributes": [
				{
					"name": "id",
					"type": "string",
					"description": "role_id (stable numeric ID as string)"
				},
				{
					"name": "name",
					"type": "string",
					"description": "Role display name"
				},
				{
					"name": "nodeId",
					"type": "string",
					"description": "Owning node_id"
				},
				{
					"name": "nodePath",
					"type": "string",
					"description": "Owning node path"
				},
				{
					"name": "admin",
					"type": "boolean",
					"description": "Whether this is an administrator role"
				},
				{
					"name": "defaultRole",
					"type": "boolean",
					"description": "Whether the role is assigned to new users by default"
				},
				{
					"name": "visibleBelow",
					"type": "boolean",
					"description": "Whether the role is visible to child nodes"
				}
			]
		}
	]
}
