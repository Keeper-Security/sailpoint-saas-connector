{
  "name": "keeper-security",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "prebuild": "npm run clean",
    "build": "npx ncc build ./src/index.ts -o ./dist -m -C",
    "dev": "npm run prebuild && npm run build && cross-env NODE_OPTIONS=--enable-source-maps spcx run dist/index.js",
    "debug": "npm run build && spcx run dist/index.js",
    "prettier": "npx prettier --write .",
    "test": "jest --coverage",
    "prepack-zip": "npm ci && npm run build",
    "pack-zip": "spcx package"
  },
  "private": true,
  "dependencies": {
    "@sailpoint/connector-sdk": "^1.0.0",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "18.19.68",
    "@vercel/ncc": "^0.38.1",
    "cross-env": "7.0.3",
    "jest": "^27.0.6",
    "prettier": "^2.3.2",
    "shx": "^0.3.3",
    "ts-jest": "^27.0.5",
    "typescript": "^4.9.5"
  },
  "overrides": {
    "@types/node": "18.19.68",
    "brace-expansion": "^5.0.8",
    "@tootallnate/once": "^2.0.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": "tests/tsconfig.json"
      }
    },
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 85,
        "functions": 85,
        "lines": 85
      }
    }
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true
  }
}
